# v0.7 development deployment: separate from v0.5 (8768) and v0.6 (8769).
CODEPUG_PROJECT_NAME=codepug-console-preview
CODEPUG_CONTAINER_NAME=codepug-console-preview
DASHBOARD_PORT=8771
# Bind local by default. Use SSH forward or a TLS-protected reverse proxy.
BIND_IP=127.0.0.1
DASHBOARD_USER=admin
# Generate with python3 scripts/create_password.py. NEVER commit real hash or token.
DASHBOARD_PASSWORD_HASH=

# Set when using an HTTPS reverse proxy, e.g. https://control.codepug.nl
DASHBOARD_PUBLIC_ORIGIN=

# Optional local status collector. Default folder is empty; add an agent or set your collector path.
# Example: HOST_SNAPSHOT_DIR=/path/to/your/collector/data
HOST_SNAPSHOT_DIR=./host-data
